    float r = ( 0.695452f      * p_R) + (  0.140679f    * p_G) + (  0.163869f    * p_B);
    float g = ( 0.0447946f     * p_R) + (  0.859671f    * p_G) + (  0.0955343f   * p_B);
    float b = ( -0.00552588f   * p_R) + (  0.00402521f  * p_G) + (  1.0015f      * p_B);
    
    return make_float3(r, g, b);
}


